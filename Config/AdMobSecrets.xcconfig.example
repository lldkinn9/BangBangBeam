// Google AdMob & Game Center 本番ID設定用テンプレート
// ※本番IDはソースコードにハードコードせず、Xcode の Build Settings（User-Defined）
//   またはこのファイルを `Config/AdMobSecrets.xcconfig` にコピーして記入してください。
//   （`Config/AdMobSecrets.xcconfig` は .gitignore 対象のため GitHub には公開されません）
// ※ xcconfig ファイル内でスラッシュ `/` を記述する場合は `$(/)` または Build Settings 画面から直接入力してください。

ADMOB_APP_ID = ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
ADMOB_BANNER_UNIT_ID = ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
ADMOB_REWARDED_UNIT_ID = ca-app-pub-XXXXXXXXXXXXXXXX/WWWWWWWWWW
GK_LEADERBOARD_ID = com.lldkinn9.BangBangBeam.kumite_streak
